-- Stable Rayfield Key System - April 2026
-- Key: 12345678910
-- Discord: https://discord.gg/2GanQsrCN

print("🔧 Starting Stable Key System... Please wait...")

local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success or not Rayfield then
    warn("❌ Failed to load Rayfield UI Library.")
    warn("Tips: Re-execute the script after fully joining the game. Try a different executor if it keeps failing.")
    return
end

task.wait(1.5) -- Extra delay to help GUI render properly

local Window = Rayfield:CreateWindow({
    Name = "InstantSteal Key System",
    LoadingTitle = "Loading Key System...",
    LoadingSubtitle = "Key System",
    ConfigurationSaving = { Enabled = false },
})

local Tab = Window:CreateTab("Key System", 4483362458)

-- Key Input
local KeyInput = Tab:CreateInput({
    Name = "Enter Key",
    PlaceholderText = "12345678910",
    RemoveTextAfterFocusLost = false,
    Callback = function() end,
})

-- Submit Button
Tab:CreateButton({
    Name = "✅ Submit Key",
    Callback = function()
        local enteredKey = (KeyInput.CurrentValue or ""):match("^%s*(.-)%s*$"):lower()
        
        if enteredKey == "12345678910" then
            Rayfield:Notify({
                Title = "✅ Success!",
                Content = "Loading InstantSteal script...",
                Duration = 5,
            })
            
            task.wait(0.8)
            task.spawn(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/Kaisoscripts/InstantSteal/refs/heads/main/Script"))()
            end)
            
            task.wait(2)
            pcall(function() Window:Destroy() end)
        else
            Rayfield:Notify({
                Title = "❌ Wrong Key",
                Content = "The correct key is: 12345678910",
                Duration = 8,
            })
        end
    end,
})

-- Discord Button
Tab:CreateButton({
    Name = "🔗 Join Discord to Get Key",
    Callback = function()
        local discordLink = "https://discord.gg/2GanQsrCN"
        
        local copied = false
        if setclipboard then
            setclipboard(discordLink)
            copied = true
        elseif toclipboard then
            toclipboard(discordLink)
            copied = true
        end
        
        if copied then
            Rayfield:Notify({
                Title = "✅ Link Copied!",
                Content = "Discord invite copied to clipboard!\nPaste with Ctrl + V",
                Duration = 10,
            })
        else
            Rayfield:Notify({
                Title = "📋 Copy Manually",
                Content = "Link: https://discord.gg/2GanQsrCN\nCopy it yourself.",
                Duration = 12,
            })
        end
    end,
})

-- Welcome notification
Rayfield:Notify({
    Title = "Key System Ready",
    Content = "Enter key: 12345678910\nOr click Join Discord",
    Duration = 10,
})

print("✅ Key System loaded. GUI should appear now.")
print("If the GUI is still not visible → Re-execute the full script after joining the game.")
